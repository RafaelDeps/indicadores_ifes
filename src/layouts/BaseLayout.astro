---
import HeaderMarca from '../components/HeaderMarca.astro';
import { obterCampiParaSelect, obterAnosParaSelect } from '../lib/dataset';
import { resolverContextoFiltro } from '../lib/ano';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Indicadores de Pesquisa e Inovação dos 3 pilares do modelo CONIF' } =
  Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isPilar1 = pathname.startsWith('/pilar-1');
const isPilar2 = pathname.startsWith('/pilar-2');
const isPilar3 = pathname.startsWith('/pilar-3');

const campiOpcoes = obterCampiParaSelect();
const anosOpcoes = obterAnosParaSelect();
const urlCampus = Astro.url.searchParams.get('campus');
const urlAno = Astro.url.searchParams.get('ano');
const contextoInicial = resolverContextoFiltro(urlCampus, urlAno, campiOpcoes, anosOpcoes);

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const pesos = [400, 600, 700];

const fontFaceCss = pesos
  .map(
    (peso) => `@font-face {
  font-family: 'Source Sans 3';
  font-style: normal;
  font-weight: ${peso};
  font-display: swap;
  src: url('${base}fonts/source-sans-3-${peso}.woff2') format('woff2');
}`,
  )
  .join('\n');
---

<!doctype html>
<html lang="pt-BR" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global set:html={fontFaceCss}></style>
    <script is:inline>
      /* Modo escuro desativado por enquanto: manter sempre visual branco institucional com as cores do IFES.
         Mantém menções para compatibilidade: data-theme="auto" e prefers-color-scheme */
      (function () {
        // Forçar visual limpo e claro com as cores do IFES
        // if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        //   document.documentElement.setAttribute('data-theme', 'escuro');
        // }
      })();
    </script>

    <!-- Plugin de acessibilidade UserWay -->
    <script is:inline src="https://cdn.userway.org/widget.js" data-account="Jmxwgqf2MY"></script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ETH675FGB0"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(...args) {
        dataLayer.push(args);
      }
      gtag('js', new Date());

      gtag('config', 'G-ETH675FGB0');
    </script>

    <!-- Microsoft Clarity -->
    <script is:inline type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function (...args) {
            (c[a].q = c[a].q || []).push(args);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', 'ymumc7n161');
    </script>
  </head>
  <body>
    <header class="topo cabecalho-fixo" role="banner">
      <div class="topo-container">
        <div class="marca-bloco">
          <HeaderMarca />
          <span class="painel-badge">Indicadores IFES</span>
        </div>

        <nav class="nav-pilares" aria-label="Navegação por pilares CONIF">
          <a
            href="/"
            class:list={['nav-aba', { ativa: isHome }]}
            aria-current={isHome ? 'page' : undefined}
          >
            Visão geral
          </a>
          <a
            href="/pilar-1/"
            class:list={['nav-aba', { ativa: isPilar1 }]}
            aria-current={isPilar1 ? 'page' : undefined}
          >
            Pilar 1
          </a>
          <a
            href="/pilar-2/"
            class:list={['nav-aba', { ativa: isPilar2 }]}
            aria-current={isPilar2 ? 'page' : undefined}
          >
            Pilar 2
          </a>
          <a
            href="/pilar-3/"
            class:list={['nav-aba', { ativa: isPilar3 }]}
            aria-current={isPilar3 ? 'page' : undefined}
          >
            Pilar 3
          </a>
        </nav>

        <div class="cabecalho-filtros" role="group" aria-label="Filtros de indicadores">
          <div class="campo-filtro">
            <label for="filtro-campus-topo" class="sr-only">Campus do IFES</label>
            <select
              id="filtro-campus-topo"
              name="campus"
              class="seletor-cabecalho"
              aria-label="Selecionar campus do IFES"
            >
              {
                campiOpcoes.map((c) => (
                  <option value={c.slug} selected={c.slug === contextoInicial.campus}>
                    {c.nome}
                  </option>
                ))
              }
            </select>
          </div>

          <div class="campo-filtro">
            <label for="filtro-ano-topo" class="sr-only">Ano de referência</label>
            <select
              id="filtro-ano-topo"
              name="ano"
              class="seletor-cabecalho"
              aria-label="Selecionar ano de referência"
            >
              {
                anosOpcoes.map((ano) => (
                  <option value={ano} selected={ano === contextoInicial.ano}>
                    {ano}
                  </option>
                ))
              }
            </select>
          </div>
        </div>

        <button
          class="btn-menu-drawer"
          aria-label="Abrir menu de navegação"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <svg
            class="icone-menu"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Gaveta Móvel (Slide-Over Drawer) -->
      <div
        id="mobile-drawer"
        class="mobile-drawer"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
      >
        <div class="drawer-backdrop" tabindex="-1"></div>
        <div class="drawer-conteudo">
          <div class="drawer-cabecalho">
            <span class="drawer-titulo">Menu de Navegação</span>
            <button class="btn-fechar-drawer" aria-label="Fechar menu">✕</button>
          </div>

          <!-- Filtros de Seleção Móvel -->
          <div class="drawer-filtros" role="group" aria-label="Filtros de visualização móvel">
            <div class="drawer-campo">
              <label for="filtro-campus-drawer" class="drawer-label">Campus:</label>
              <select
                id="filtro-campus-drawer"
                name="campus"
                class="seletor-drawer"
                aria-label="Selecionar campus do IFES"
              >
                {
                  campiOpcoes.map((c) => (
                    <option value={c.slug} selected={c.slug === contextoInicial.campus}>
                      {c.nome}
                    </option>
                  ))
                }
              </select>
            </div>

            <div class="drawer-campo">
              <label for="filtro-ano-drawer" class="drawer-label">Ano:</label>
              <select
                id="filtro-ano-drawer"
                name="ano"
                class="seletor-drawer"
                aria-label="Selecionar ano de referência"
              >
                {
                  anosOpcoes.map((ano) => (
                    <option value={ano} selected={ano === contextoInicial.ano}>
                      {ano}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>

          <nav class="drawer-nav" aria-label="Menu móvel de pilares">
            <a
              href="/"
              class:list={['drawer-link', { ativa: isHome }]}
              aria-current={isHome ? 'page' : undefined}
            >
              Visão geral
            </a>
            <a
              href="/pilar-1/"
              class:list={['drawer-link', { ativa: isPilar1 }]}
              aria-current={isPilar1 ? 'page' : undefined}
            >
              Pilar 1
            </a>
            <a
              href="/pilar-2/"
              class:list={['drawer-link', { ativa: isPilar2 }]}
              aria-current={isPilar2 ? 'page' : undefined}
            >
              Pilar 2
            </a>
            <a
              href="/pilar-3/"
              class:list={['drawer-link', { ativa: isPilar3 }]}
              aria-current={isPilar3 ? 'page' : undefined}
            >
              Pilar 3
            </a>
          </nav>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="rodape">
      <p>
        Valores transcritos do relatório oficial. Indicadores sem dados são exibidos como “Dado
        indisponível” — nenhum valor é estimado.
      </p>
    </footer>

    <script is:inline>
      /* Controle da gaveta móvel (Slide-Over Drawer) */
      (function () {
        const btnAbrir = document.querySelector('.btn-menu-drawer');
        const drawer = document.getElementById('mobile-drawer');
        const btnFechar = document.querySelector('.btn-fechar-drawer');
        const backdrop = document.querySelector('.drawer-backdrop');

        if (!btnAbrir || !drawer) return;

        function abrirDrawer() {
          drawer.classList.add('aberto');
          drawer.setAttribute('aria-hidden', 'false');
          btnAbrir.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          if (btnFechar) btnFechar.focus();
        }

        function fecharDrawer() {
          drawer.classList.remove('aberto');
          drawer.setAttribute('aria-hidden', 'true');
          btnAbrir.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          btnAbrir.focus();
        }

        btnAbrir.addEventListener('click', abrirDrawer);
        if (btnFechar) btnFechar.addEventListener('click', fecharDrawer);
        if (backdrop) backdrop.addEventListener('click', fecharDrawer);

        window.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && drawer.classList.contains('aberto')) {
            fecharDrawer();
          }
        });
      })();

      /* Normalização universal de links internos para GitHub Pages e
         propagação contínua de parâmetros (?campus=...&ano=...).
         Garante que nenhum link gere erro 404 em subpastas de repositório. */
      (function () {
        const path = window.location.pathname;
        const repoName = 'indicadores_ifes';
        const basePath =
          path.startsWith('/' + repoName) || path.includes('/' + repoName + '/')
            ? '/' + repoName
            : '';

        function normalizarHref(href) {
          if (
            !href ||
            href.startsWith('//') ||
            href.startsWith('#') ||
            href.startsWith('http:') ||
            href.startsWith('https:') ||
            href.startsWith('mailto:')
          ) {
            return href;
          }
          let destino = href;
          if (
            basePath &&
            destino.startsWith('/') &&
            !destino.startsWith(basePath + '/') &&
            destino !== basePath
          ) {
            destino = destino === '/' ? basePath + '/' : basePath + destino;
          }
          return destino;
        }

        function propagarContexto() {
          const params = new URLSearchParams(window.location.search);
          const campus = params.get('campus');
          const ano = params.get('ano');

          document.querySelectorAll('a[href]').forEach(function (link) {
            const raw = link.getAttribute('href');
            if (
              !raw ||
              raw.startsWith('//') ||
              raw.startsWith('#') ||
              raw.startsWith('http:') ||
              raw.startsWith('https:')
            )
              return;

            let resolvido = normalizarHref(raw);

            if (campus || ano) {
              try {
                const url = new URL(resolvido, window.location.origin);
                if (campus && !url.searchParams.has('campus')) {
                  url.searchParams.set('campus', campus);
                }
                if (ano && !url.searchParams.has('ano')) {
                  url.searchParams.set('ano', ano);
                }
                resolvido = url.pathname + url.search + url.hash;
              } catch {
                /* ignora erros de url inválida */
              }
            }

            if (resolvido !== raw) {
              link.setAttribute('href', resolvido);
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', propagarContexto);
        } else {
          propagarContexto();
        }
        window.addEventListener('popstate', propagarContexto);

        /* Interceptor de cliques: assegura que qualquer clique em link relativo
           seja redirecionado para a rota correta do repositório antes de disparar 404 */
        document.addEventListener(
          'click',
          function (e) {
            const a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            const raw = a.getAttribute('href');
            if (
              !raw ||
              raw.startsWith('//') ||
              raw.startsWith('#') ||
              raw.startsWith('http:') ||
              raw.startsWith('https:')
            )
              return;

            const normalizado = normalizarHref(raw);
            if (normalizado !== raw) {
              a.setAttribute('href', normalizado);
            }
          },
          true,
        );
      })();

      /* Sincronização e interação dos seletores de Campus e Ano (Desktop e Mobile Drawer) */
      (function () {
        const selectCampusTopo = document.getElementById('filtro-campus-topo');
        const selectAnoTopo = document.getElementById('filtro-ano-topo');
        const selectCampusDrawer = document.getElementById('filtro-campus-drawer');
        const selectAnoDrawer = document.getElementById('filtro-ano-drawer');

        function sincronizarValoresDaUrl() {
          const params = new URLSearchParams(window.location.search);
          const campus = params.get('campus');
          const ano = params.get('ano');

          if (campus) {
            if (selectCampusTopo) selectCampusTopo.value = campus;
            if (selectCampusDrawer) selectCampusDrawer.value = campus;
          }
          if (ano) {
            if (selectAnoTopo) selectAnoTopo.value = ano;
            if (selectAnoDrawer) selectAnoDrawer.value = ano;
          }
        }

        function aplicarFiltro(novoCampus, novoAno) {
          const url = new URL(window.location.href);
          if (novoCampus && novoCampus !== 'todos') {
            url.searchParams.set('campus', novoCampus);
          } else {
            url.searchParams.delete('campus');
          }
          if (novoAno) {
            url.searchParams.set('ano', String(novoAno));
          } else {
            url.searchParams.delete('ano');
          }
          window.location.href = url.pathname + url.search + url.hash;
        }

        function sincronizarPar(topo, drawer, onChange) {
          if (topo) {
            topo.addEventListener('change', function () {
              if (drawer) drawer.value = topo.value;
              onChange(topo.value);
            });
          }
          if (drawer) {
            drawer.addEventListener('change', function () {
              if (topo) topo.value = drawer.value;
              onChange(drawer.value);
            });
          }
        }

        sincronizarPar(selectCampusTopo, selectCampusDrawer, function (campusVal) {
          const anoAtual = selectAnoTopo
            ? selectAnoTopo.value
            : selectAnoDrawer
              ? selectAnoDrawer.value
              : undefined;
          aplicarFiltro(campusVal, anoAtual);
        });

        sincronizarPar(selectAnoTopo, selectAnoDrawer, function (anoVal) {
          const campusAtual = selectCampusTopo
            ? selectCampusTopo.value
            : selectCampusDrawer
              ? selectCampusDrawer.value
              : undefined;
          aplicarFiltro(campusAtual, anoVal);
        });

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', sincronizarValoresDaUrl);
        } else {
          sincronizarValoresDaUrl();
        }
        window.addEventListener('popstate', sincronizarValoresDaUrl);
      })();
    </script>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    font-family: var(--font-sans);
    color: var(--color-ink);
    background: var(--color-bg);
    line-height: 1.55;
  }

  a {
    color: var(--color-primary-dark);
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
  }
</style>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: 0.75rem 1.25rem;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .topo-container {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .marca-bloco {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .painel-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background: var(--color-emerald-50);
    color: var(--color-emerald-700);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav-pilares {
    display: none;
    align-items: center;
    gap: 0.35rem;
  }

  .cabecalho-filtros {
    display: none;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .nav-pilares {
      display: flex;
    }
    .cabecalho-filtros {
      display: flex;
    }
    .btn-menu-drawer {
      display: none;
    }
  }

  .campo-filtro {
    display: flex;
    align-items: center;
  }

  .seletor-cabecalho {
    padding: 0.35rem 0.65rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .seletor-cabecalho:hover {
    border-color: var(--color-primary);
  }

  .seletor-cabecalho:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Drawer filtros móveis */
  .drawer-filtros {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer-campo {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .drawer-label {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .seletor-drawer {
    width: 100%;
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    cursor: pointer;
  }

  .seletor-drawer:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav-aba {
    padding: 0.45rem 0.8rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-muted);
    border-radius: 6px;
    border-bottom: 2px solid transparent;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .nav-aba:hover {
    color: var(--color-primary-dark);
    background: var(--color-emerald-50);
  }

  .nav-aba.ativa,
  .nav-aba[aria-current='page'] {
    color: var(--color-primary);
    background: var(--color-emerald-50);
    border-bottom-color: var(--color-primary);
  }

  .btn-menu-drawer {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem;
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-ink);
    cursor: pointer;
  }

  .btn-menu-drawer:hover {
    background: var(--color-emerald-50);
  }

  /* Slide-over Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    visibility: hidden;
    transition: visibility 0.25s ease;
  }

  .mobile-drawer.aberto {
    visibility: visible;
  }

  .drawer-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .mobile-drawer.aberto .drawer-backdrop {
    opacity: 1;
  }

  .drawer-conteudo {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 280px;
    max-width: 80vw;
    background: var(--color-surface);
    padding: 1.5rem;
    box-shadow: -4px 0 12px rgba(0, 0, 0, 0.15);
    transform: translateX(100%);
    transition: transform 0.25s ease;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-drawer.aberto .drawer-conteudo {
    transform: translateX(0);
  }

  .drawer-cabecalho {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer-titulo {
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-ink);
  }

  .btn-fechar-drawer {
    background: none;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--color-muted);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .btn-fechar-drawer:hover {
    color: var(--color-ink);
    background: var(--color-emerald-50);
  }

  .drawer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .drawer-link {
    padding: 0.65rem 0.85rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--color-ink);
    border-radius: 6px;
    transition:
      background 0.15s ease,
      color 0.15s ease;
  }

  .drawer-link:hover,
  .drawer-link.ativa {
    background: var(--color-emerald-50);
    color: var(--color-primary);
  }

  main {
