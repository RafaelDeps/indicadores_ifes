---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndicatorCard from '../../components/IndicatorCard.astro';
import MemoriaCalculo from '../../components/MemoriaCalculo.astro';
import SecaoRastreabilidade from '../../components/SecaoRastreabilidade.astro';
import BotaoRaioX from '../../components/BotaoRaioX.astro';
import RaioXDrawer from '../../components/RaioXDrawer.astro';
import { portaoAberto } from '../../lib/downloads';
import { anoPadrao } from '../../lib/ano';
import { obterAnosDisponiveis } from '../../lib/dataset';
import { obterIndicadoresPorPilar } from '../../lib/selectors';
import { obterRastreabilidadePilar } from '../../lib/rastreabilidade';

const indicadoresP2 = obterIndicadoresPorPilar(2, 'serra');
const anoMemoria = (ind: (typeof indicadoresP2)[number]) =>
  anoPadrao(ind) ?? obterAnosDisponiveis().at(-1) ?? 2026;

const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const rastreabilidade = obterRastreabilidadePilar(2);
const citacoes = rastreabilidade.artefatos.map((artefato) => ({ rotulo: artefato.rotulo }));
const exibirRaiox = portaoAberto();
---

<BaseLayout title="Pilar 2 — Fomento e Conexão com o Ecossistema | Indicadores IFES">
  <nav class="trilha" aria-label="Trilha de navegação">
    <a href="/">Início</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Pilar 2</span>
  </nav>
  <h1>Indicadores do Pilar 2</h1>
  <p class="subtitulo">
    Fomento e Conexão com o Ecossistema — investimentos captados e acordos de parceria para PDeI.
  </p>
  <div class="grade">
    {
      indicadoresP2.map((indicador) => (
        <div class="celula-indicador">
          <IndicatorCard indicador={indicador} />
          {exibirRaiox && <BotaoRaioX sigla={indicador.sigla} />}
          <MemoriaCalculo
            indicador={indicador}
            contextoInicial={{ campus: 'serra', ano: anoMemoria(indicador) }}
            citacoes={citacoes}
          />
        </div>
      ))
    }
  </div>
  <SecaoRastreabilidade rastreabilidade={rastreabilidade} base={base} />
  {exibirRaiox && <RaioXDrawer base={base} />}
</BaseLayout>

<style>
  .trilha {
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.4rem;
  }

  h1 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .subtitulo {
    color: var(--color-muted);
    margin-top: 0;
  }

  .grade {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .celula-indicador {
    display: flex;
    flex-direction: column;
  }

  .celula-indicador :global(.cartao-indicador) {
    border-radius: 12px 12px 0 0;
    box-shadow: none;
  }

  @media (min-width: 640px) {
    .grade {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
