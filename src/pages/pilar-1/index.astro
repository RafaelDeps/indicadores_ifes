---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndicatorCard from '../../components/IndicatorCard.astro';
import { obterIndicadoresPorPilar } from '../../lib/selectors';

const indicadoresP1 = obterIndicadoresPorPilar(1, 'serra');
---

<BaseLayout title="Pilar 1 — Engajamento Acadêmico e Inclusão | Indicadores IFES">
  <nav class="trilha" aria-label="Trilha de navegação">
    <a href="/">Início</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">Pilar 1</span>
  </nav>
  <h1>Indicadores do Pilar 1</h1>
  <p class="subtitulo">
    Engajamento Acadêmico e Inclusão — quatro indicadores do modelo CONIF, com valores por ano.
  </p>
  <div class="grade">
    {indicadoresP1.map((indicador) => <IndicatorCard indicador={indicador} />)}
  </div>
</BaseLayout>

<style>
  .trilha {
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    display: flex;
    gap: 0.4rem;
  }

  h1 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .subtitulo {
    color: var(--color-muted);
    margin-top: 0;
  }

  .grade {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .grade {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
