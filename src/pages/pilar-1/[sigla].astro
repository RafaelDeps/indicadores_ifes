---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndicadorDetalhe from '../../components/IndicadorDetalhe.astro';
import type { Indicador } from '../../data/indicadores';
import { anoSolicitado } from '../../lib/ano';
import { seriesFor, obterIndicadoresPorPilar, obterIndicadorPorSigla } from '../../lib/selectors';

export function getStaticPaths() {
  const pilar1Indicadores = obterIndicadoresPorPilar(1, 'serra');
  return pilar1Indicadores.map((ind) => ({
    params: { sigla: ind.slug },
    props: { sigla: ind.sigla },
  }));
}

interface Props {
  sigla: string;
}

const { sigla } = Astro.props;
const indicador = obterIndicadorPorSigla(sigla, 'serra') as Indicador;
const serie = seriesFor(indicador);

// Ano efetivo: ?ano= bem-formado tem precedência; sem/inválido → padrão.
const consulta = Astro.url.searchParams.get('ano');
const anoEfetivo = anoSolicitado(consulta, indicador);

const valorItem = anoEfetivo !== null ? serie.find((v) => v.ano === anoEfetivo) : null;
const valorPrincipal = valorItem?.valor ?? null;
---

<BaseLayout
  title={`${indicador.sigla} — Pilar 1 | Indicadores IFES`}
  description={indicador.oQueMede}
>
  <IndicadorDetalhe
    indicador={indicador}
    pilarNumero={1}
    anoEfetivo={anoEfetivo}
    serie={serie}
    valorPrincipal={valorPrincipal}
  />
</BaseLayout>
