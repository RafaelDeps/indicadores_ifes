---
export interface Props {
  base?: string;
}

const { base = '/' } = Astro.props;
---

<div class="raiox-overlay" data-raiox-overlay hidden></div>

<dialog
  class="raiox-drawer"
  data-raiox-dialog
  data-raiox-base={base}
  role="dialog"
  aria-modal="true"
  aria-labelledby="raiox-titulo"
  hidden
>
  <div class="raiox-cabecalho">
    <div class="raiox-cabecalho-texto">
      <h2 id="raiox-titulo" data-raiox-titulo>Raio-X do Indicador</h2>
      <span class="raiox-subtitulo">Auditoria de microdados e conferência de registros</span>
    </div>
    <button
      type="button"
      class="btn-fechar-drawer"
      data-raiox-fechar
      aria-label="Fechar Raio-X do Indicador"
      title="Fechar janela (ESC)"
    >
      <span aria-hidden="true">&times;</span>
    </button>
  </div>

  <div class="raiox-conteudo">
    <div class="raiox-status" data-raiox-status hidden>
      <div class="spinner" data-raiox-spinner hidden></div>
      <p class="status-texto" data-raiox-status-texto></p>
      <button type="button" class="btn-tentar-novamente" data-raiox-tentar-novamente hidden>
        Tentar novamente
      </button>
    </div>

    <div class="raiox-abas-container" data-raiox-abas-container>
      <div
        class="raiox-tablist"
        role="tablist"
        data-raiox-tablist
        aria-label="Componentes da fórmula"
      >
      </div>
      <div class="raiox-paineis" data-raiox-paineis></div>
    </div>
  </div>

  <div class="raiox-rodape">
    <div class="raiox-rodape-metadados">
      <div class="raiox-rodape-formula" data-raiox-rodape-formula></div>
      <div class="raiox-proveniencia" data-raiox-proveniencia></div>
    </div>
    <div class="raiox-rodape-acoes">
      <button
        type="button"
        class="btn-exportar-csv"
        data-raiox-exportar
        title="Exportar os registros da aba ativa em formato CSV"
      >
        <svg
          class="icone-download"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Exportar lista (.csv)</span>
      </button>
    </div>
  </div>
</dialog>

<style>
  .raiox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(15, 23, 42, 0.45);
    backdrop-filter: blur(2px);
    z-index: 999;
  }

  .raiox-overlay[hidden] {
    display: none;
  }

  .raiox-drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 760px;
    height: 100vh;
    max-height: 100vh;
    margin: 0 0 0 auto;
    padding: 1.5rem;
    background: var(--color-surface);
    color: var(--color-text);
    border: none;
    border-left: 1px solid var(--color-border);
    box-shadow: -4px 0 24px rgba(0, 0, 0, 0.15);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-sizing: border-box;
  }

  .raiox-drawer[hidden] {
    display: none;
  }

  .raiox-cabecalho {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .raiox-cabecalho h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .raiox-subtitulo {
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .btn-fechar-drawer {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    width: 2rem;
    height: 2rem;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    transition: all 0.15s ease;
  }

  .btn-fechar-drawer:hover {
    background: var(--color-emerald-50);
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  .raiox-conteudo {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0;
    display: flex;
    flex-direction: column;
  }

  .raiox-tablist {
    display: flex;
    gap: 0.5rem;
    border-bottom: 2px solid var(--color-border);
    margin-bottom: 1rem;
    overflow-x: auto;
  }

  :global(.raiox-tab) {
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    margin-bottom: -2px;
    cursor: pointer;
    color: var(--color-muted);
    white-space: nowrap;
    transition: all 0.15s ease;
  }

  :global(.raiox-tab:hover) {
    color: var(--color-primary);
  }

  :global(.raiox-tab[aria-selected='true']) {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  :global(.raiox-painel[hidden]) {
    display: none;
  }

  :global(.raiox-painel-topo) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  :global(.raiox-selo) {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    width: fit-content;
  }

  :global(.raiox-selo-conferido) {
    background: var(--color-emerald-50);
    color: var(--color-emerald-700);
    border: 1px solid var(--color-primary-light);
  }

  :global(.raiox-selo-divergencia) {
    background: var(--color-notice-bg);
    color: var(--color-notice-text);
    border: 1px solid var(--color-notice-border);
  }

  :global(.raiox-selo-aviso) {
    background: var(--color-badge-unavailable);
    color: var(--color-badge-unavailable-text);
    border: 1px solid var(--color-border);
  }

  :global(.raiox-controles) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  :global(.raiox-busca-input) {
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    width: 240px;
    background: var(--color-surface);
    color: var(--color-text);
  }

  :global(.raiox-tabela-scroll) {
    max-height: 480px;
    overflow: auto;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
  }

  :global(.raiox-tabela) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    text-align: left;
  }

  :global(.raiox-tabela th) {
    position: sticky;
    top: 0;
    background: var(--color-emerald-50);
    padding: 0.6rem 0.75rem;
    font-weight: 600;
    border-bottom: 2px solid var(--color-border);
    cursor: pointer;
    user-select: none;
    z-index: 10;
  }

  :global(.raiox-tabela td) {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  :global(.raiox-tabela tr:hover td) {
    background: var(--color-emerald-50);
  }

  :global(.raiox-paginacao) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    font-size: 0.85rem;
    gap: 0.5rem;
  }

  .raiox-rodape {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .btn-exportar-csv {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-surface);
    background: var(--color-primary);
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-exportar-csv:hover {
    background: var(--color-primary-dark);
  }
</style>
