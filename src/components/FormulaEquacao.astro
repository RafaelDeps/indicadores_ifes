---
import { decomporFormula } from '../lib/formula';

interface Props {
  formula: string;
  sigla: string;
}

const { formula, sigla } = Astro.props;
const eq = decomporFormula(formula, sigla);
---

<div class="bloco-equacao" role="region" aria-label={`Fórmula de cálculo para ${sigla}`}>
  <span class="sr-only">{eq.textoAcessivel}</span>

  <div class="equacao-visual" aria-hidden="true">
    <span class="membro-esquerdo">{eq.siglaResultado}</span>
    <span class="operador-igual">=</span>

    {
      eq.tipo === 'fracao' && eq.fracao && (
        <div class="termo-fracao">
          <div class="numerador">
            <span class="token-variavel" data-variavel-simbolo={eq.fracao.numerador} tabindex="0">
              {eq.fracao.numerador}
            </span>
          </div>
          <div class="traco-fracao" />
          <div class="denominador">
            <span class="token-variavel" data-variavel-simbolo={eq.fracao.denominador} tabindex="0">
              {eq.fracao.denominador}
            </span>
          </div>
        </div>
      )
    }

    {
      eq.tipo === 'fracao' && eq.fracao?.multiplicador && (
        <>
          <span class="operador-mult">×</span>
          <span class="constante">{eq.fracao.multiplicador}</span>
        </>
      )
    }

    {
      eq.tipo === 'soma' && eq.termosSoma && (
        <div class="termo-soma">
          {eq.termosSoma.map((termo, index) => (
            <>
              {index > 0 && <span class="operador-mais">+</span>}
              <span class="token-variavel" data-variavel-simbolo={termo} tabindex="0">
                {termo}
              </span>
            </>
          ))}
        </div>
      )
    }

    {
      eq.tipo === 'direta' && (
        <span class="termo-direto">
          <span class="token-variavel" data-variavel-simbolo={eq.expressaoDireta} tabindex="0">
            {eq.expressaoDireta}
          </span>
        </span>
      )
    }
  </div>
</div>

<style>
  .bloco-equacao {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-primary);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
  }

  .equacao-visual {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-sans);
    color: var(--color-ink);
    font-size: 1.15rem;
  }

  .membro-esquerdo {
    font-family: var(--font-mono);
    font-weight: 800;
    color: var(--color-primary-dark);
  }

  .operador-igual,
  .operador-mult,
  .operador-mais {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-muted);
  }

  .constante {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-ink);
  }

  /* Fração */
  .termo-fracao {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    vertical-align: middle;
    padding: 0 0.35rem;
  }

  .numerador,
  .denominador {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.2rem 0.4rem;
  }

  .traco-fracao {
    width: 100%;
    height: 2px;
    background: var(--color-ink);
    opacity: 0.85;
    margin: 0.1rem 0;
  }

  /* Termos em soma */
  .termo-soma {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  /* Token de variável interativa */
  .token-variavel {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-primary-dark);
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    border: 1px solid transparent;
    cursor: pointer;
    background: transparent;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease,
      box-shadow 0.15s ease;
  }

  .token-variavel:hover,
  .token-variavel:focus-visible,
  .token-variavel.destaque-ativo {
    background: var(--color-emerald-50);
    border-color: var(--color-primary);
    color: var(--color-primary);
    box-shadow: 0 0 0 2px rgba(23, 132, 71, 0.15);
    outline: none;
  }

  /* Acessibilidade para leitores de tela */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
