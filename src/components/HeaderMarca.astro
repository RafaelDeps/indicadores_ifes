---
/* Marca institucional oficial do IFES: Logotipo em grade de 9 blocos + texto institucional */
---

<a href="/" class="marca-link" aria-label="Instituto Federal do Espírito Santo - Página inicial">
  <svg
    class="ifes-grid-logo"
    viewBox="0 0 48 48"
    role="img"
    aria-hidden="true"
    width="40"
    height="40"
  >
    <!-- Círculo vermelho superior esquerdo -->
    <circle class="circulo-vermelho" cx="8" cy="8" r="6"></circle>

    <!-- 8 quadrados verdes restantes em matriz 3x3 -->
    <rect class="bloco-verde" x="18" y="2" width="12" height="12" rx="2"></rect>
    <rect class="bloco-verde" x="34" y="2" width="12" height="12" rx="2"></rect>
    <rect class="bloco-verde" x="2" y="18" width="12" height="12" rx="2"></rect>
    <rect class="bloco-verde" x="18" y="18" width="12" height="12" rx="2"></rect>
    <rect class="bloco-verde" x="34" y="18" width="12" height="12" rx="2"></rect>
    <rect class="bloco-verde" x="2" y="34" width="12" height="12" rx="2"></rect>
    <rect class="bloco-verde" x="18" y="34" width="12" height="12" rx="2"></rect>
    <rect class="bloco-verde" x="34" y="34" width="12" height="12" rx="2"></rect>
  </svg>
  <div class="marca-texto">
    <span class="marca-instituto">INSTITUTO FEDERAL</span>
    <span class="marca-campus">Espírito Santo</span>
  </div>
</a>

<style>
  .marca-link {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }

  .marca-link:hover {
    opacity: 0.9;
  }

  .ifes-grid-logo {
    display: block;
    flex-shrink: 0;
  }

  .circulo-vermelho {
    fill: var(--color-red-primary);
  }

  .bloco-verde {
    fill: var(--color-primary);
  }

  .marca-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .marca-instituto {
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--color-primary-dark);
  }

  .marca-campus {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
