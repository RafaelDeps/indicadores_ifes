---
/* Marca institucional oficial do IFES: logotipo horizontal colorido em imagem oficial (public/ifes-horizontal-cor.png) */
const rawBase = import.meta.env.BASE_URL ?? '/';
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const logotipoUrl = `${base}ifes-horizontal-cor.png`;
---

<a href="/" class="marca-link" aria-label="Instituto Federal do Espírito Santo - Página inicial">
  <img
    src={logotipoUrl}
    class="ifes-logo"
    alt="Instituto Federal do Espírito Santo"
    width="2835"
    height="1134"
  />
</a>

<style>
  .marca-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.15s ease;
  }

  .marca-link:hover {
    opacity: 0.9;
  }

  .ifes-logo {
    display: block;
    height: 3.5rem;
    width: auto;
    max-width: 100%;
  }
</style>
