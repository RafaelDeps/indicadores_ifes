---
import type { ValorAnual } from '../data/indicadores';
import { formatValor } from '../lib/formatters';
import { construirLinha, mapearPontos, calcularEscala } from '../lib/chart';

interface Props {
  valores: ValorAnual[];
  anoSelecionado?: number;
}

const { valores, anoSelecionado } = Astro.props;
const LARGURA = 560;
const ALTURA = 240;
const MARGEM = 36;

const pontos = mapearPontos(valores, LARGURA, ALTURA, MARGEM);
const linha = construirLinha(pontos);
const escala = calcularEscala(valores, ALTURA, MARGEM);

function rotuloDoPonto(ano: number): string {
  const item = valores.find((v) => v.ano === ano);
  return `${ano}: ${formatValor(item?.valor ?? null)}`;
}
---

<div class="grafico-wrapper">
  <svg
    class="grafico"
    data-grafico-svg
    viewBox={`0 0 ${LARGURA} ${ALTURA}`}
    role="img"
    aria-label="Série histórica do indicador com rótulos numéricos e eixos de escala"
    style={pontos.length > 0 ? '' : 'display: none;'}
  >
    {/* Linhas de grade e referências da escala vertical */}
    <g class="escala-grupo" data-grafico-escala>
      {
        escala &&
          escala.linhas.map((l) => (
            <g class="grade-linha">
              <line class="linha-guia" x1={MARGEM} y1={l.y} x2={LARGURA - MARGEM} y2={l.y} />
              <text class="rotulo-escala" x={MARGEM - 6} y={l.y + 4} text-anchor="end">
                {l.rotulo}
              </text>
            </g>
          ))
      }
    </g>

    {/* Eixo horizontal (tempo) */}
    <line class="eixo" x1={MARGEM} y1={ALTURA - MARGEM} x2={LARGURA - MARGEM} y2={ALTURA - MARGEM}
    ></line>

    {/* Linha da série de dados */}
    <path class="linha" data-grafico-linha d={linha} fill="none"></path>

    {/* Pontos de dados com rótulos visíveis e tooltips */}
    <g class="pontos-grupo" data-grafico-pontos>
      {
        pontos.map((ponto) => {
          const ativo = ponto.ano === anoSelecionado;
          return (
            <g class="grupo-ponto" tabindex="0" data-ponto-ano={ponto.ano}>
              {/* Rótulo numérico visível sobre o ponto */}
              <text class="rotulo-dado" x={ponto.rotuloX} y={ponto.rotuloY} text-anchor="middle">
                {ponto.textoRotulo}
              </text>

              {/* Rótulo do ano no eixo horizontal */}
              <text class="rotulo-ano" x={ponto.x} y={ALTURA - MARGEM + 18} text-anchor="middle">
                {ponto.ano}
              </text>

              {/* Círculo do ponto */}
              <circle
                class:list={['ponto', { 'ponto-ativo': ativo }]}
                cx={ponto.x}
                cy={ponto.y}
                r={ativo ? 8 : 6}
              >
                <title>{rotuloDoPonto(ponto.ano)}</title>
              </circle>
            </g>
          );
        })
      }
    </g>
  </svg>

  <p class="sem-grafico" data-grafico-vazio style={pontos.length > 0 ? 'display: none;' : ''}>
    Não há valores suficientes para desenhar o gráfico.
  </p>
</div>

<style>
  .grafico-wrapper {
    position: relative;
    width: 100%;
  }

  .grafico {
    width: 100%;
    height: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-family: var(--font-sans);
    overflow: visible;
  }

  .eixo {
    stroke: var(--color-border);
    stroke-width: 1.5;
  }

  .linha-guia {
    stroke: var(--color-border);
    stroke-width: 1;
    stroke-dasharray: 3 3;
    opacity: 0.6;
  }

  .rotulo-escala {
    font-size: 0.72rem;
    fill: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .rotulo-ano {
    font-size: 0.78rem;
    fill: var(--color-muted);
    font-weight: 600;
  }

  .linha {
    stroke: var(--color-primary);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .grupo-ponto {
    outline: none;
    cursor: pointer;
  }

  .ponto {
    fill: var(--color-primary);
    stroke: var(--color-surface);
    stroke-width: 2;
    transition:
      r 0.15s ease,
      fill 0.15s ease;
  }

  .ponto.ponto-ativo {
    fill: var(--color-primary-dark);
    stroke: var(--color-emerald-50);
    stroke-width: 3px;
    filter: drop-shadow(0 0 4px rgba(23, 132, 71, 0.4));
  }

  .grupo-ponto:hover .ponto,
  .grupo-ponto:focus-visible .ponto {
    r: 8;
    fill: var(--color-primary-dark);
  }

  .rotulo-dado {
    font-size: 0.82rem;
    font-weight: 700;
    fill: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .sem-grafico {
    color: var(--color-muted);
    font-style: italic;
  }
</style>
